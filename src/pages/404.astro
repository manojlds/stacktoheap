---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---

<BaseLayout title="Page not found" description="The page you requested could not be found.">
  <div class="container py-16 md:py-24">
    <div class="mx-auto flex max-w-2xl flex-col items-start gap-4">
      <p class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">404</p>
      <h1 class="text-4xl font-extrabold tracking-tight md:text-5xl">Page not found</h1>
      <p class="max-w-[42rem] text-lg text-muted-foreground">
        That URL does not match anything on StackToHeap. The post may have moved, or the link may be mistyped.
      </p>
      <div class="mt-2 flex flex-wrap gap-4">
        <Button href="/" size="lg">Go home</Button>
        <Button href="/blog/" variant="outline" size="lg">Read the blog</Button>
      </div>
    </div>
  </div>
</BaseLayout>
