---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

// X Article export: an unlinked, noindex page per draft in src/content/x/.
// It copies the article as rich text and each diagram or cover as a PNG,
// which X's editor accepts and a sandboxed preview cannot provide.
// Built only when X_EXPORT=true (set in the gitignored .env), so the deployed
// site never has these pages.
export async function getStaticPaths() {
  if (import.meta.env.X_EXPORT !== 'true') return [];
  const drafts = await getCollection('x');
  return drafts.map((draft) => ({ params: { id: draft.id }, props: { draft } }));
}

const { draft } = Astro.props;
const { Content } = await render(draft);
const post = await getEntry('blog', draft.id);
const title = draft.data.title ?? post?.data.title ?? draft.id;
const cover = draft.data.cover ?? post?.data.hero_image;
---

<BaseLayout title={`X article: ${title}`} noindex>
  <div class="container py-8 md:py-12">
    <div class="mx-auto max-w-3xl space-y-6">
      <div class="rounded-lg border p-4 text-sm text-muted-foreground">
        <p class="font-semibold text-foreground">Posting as an X Article</p>
        <ol class="mt-2 list-decimal space-y-1 pl-5">
          <li>On x.com, open <b>Articles</b> and click <b>Write</b>.</li>
          <li>Copy the title, then add the cover with <b>Copy image</b> or <b>Download PNG</b>.</li>
          <li>Copy the body and paste it into the editor. Each diagram becomes an <b>[Insert image n]</b> line and each table an <b>[Insert table n]</b> line.</li>
          <li>Replace each of those lines with the matching diagram or table, using its buttons below. Tables copy as Markdown.</li>
          <li>If the formatting does not survive the paste, use <b>Copy body as Markdown</b> instead.</li>
        </ol>
      </div>

      <div class="sticky top-0 z-10 flex flex-wrap items-center gap-2 border-b bg-background py-3">
        <button type="button" class="x-button" data-x-copy="title">Copy title</button>
        <button type="button" class="x-button x-button-primary" data-x-copy="body">Copy body</button>
        <button type="button" class="x-button" data-x-copy="markdown">Copy body as Markdown</button>
        <span class="text-sm text-muted-foreground" role="status" data-x-status></span>
      </div>

      <h1 class="text-3xl font-extrabold tracking-tight" data-x-title>{title}</h1>

      {cover && (
        <figure class="x-figure" data-x-cover>
          <img src={cover} alt="Cover image" class="w-full rounded-lg border" />
          <figcaption class="x-actions">
            <span>Cover</span>
            <button type="button" class="x-button" data-x-image="copy">Copy image</button>
            <button type="button" class="x-button" data-x-image="download">Download PNG</button>
          </figcaption>
        </figure>
      )}

      <script type="application/json" data-x-markdown set:html={JSON.stringify(draft.body ?? '')} />

      <div class="prose prose-lg max-w-none dark:prose-invert x-body" data-x-body>
        <Content />
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .x-button {
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .x-button:hover {
    background: hsl(var(--muted));
  }
  .x-button-primary {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }
  .x-button-primary:hover {
    background: hsl(var(--foreground) / 0.85);
  }
  .x-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  /* Diagrams always use the light palette, so the PNG matches what is on screen. */
  .x-body .pele {
    --background: 0 0% 100%;
    --foreground: 222.2 84% 4.9%;
    --muted: 210 40% 96.1%;
    --muted-foreground: 215.4 16.3% 46.9%;
    --destructive: 0 84.2% 60.2%;
  }
  .x-body .pele-diagram svg {
    background: #fff;
    border-radius: 0.5rem;
    padding: 0.75rem;
  }
</style>

<script>
  const status = document.querySelector<HTMLElement>('[data-x-status]')!;
  const body = document.querySelector<HTMLElement>('[data-x-body]')!;
  const figures = [...body.querySelectorAll<HTMLElement>('.pele-diagram')];
  const say = (text: string) => (status.textContent = text);

  const peleVars = [
    '--pele-bg', '--pele-fg', '--pele-fg-on-light', '--pele-fg-on-dark', '--pele-muted', '--pele-line',
    '--pele-surface', '--pele-surface-alt', '--pele-border', '--pele-accent', '--pele-critical', '--pele-error',
  ];

  // Resolve the theme's CSS variables onto a detached copy, which loses the page's styles.
  function standalone(svg: SVGSVGElement): SVGSVGElement {
    const copy = svg.cloneNode(true) as SVGSVGElement;
    const specified = getComputedStyle(svg);
    const probe = document.createElement('span');
    document.body.append(probe);
    for (const name of peleVars) {
      const value = specified.getPropertyValue(name).trim();
      if (!value) continue;
      probe.style.color = value;
      copy.style.setProperty(name, getComputedStyle(probe).color);
    }
    probe.remove();
    for (const name of ['--pele-font', '--pele-font-mono', '--pele-radius']) {
      const value = specified.getPropertyValue(name).trim();
      if (value) copy.style.setProperty(name, value);
    }
    return copy;
  }

  async function draw(source: string, width: number, height: number, pad: number): Promise<Blob> {
    const image = new Image();
    image.src = source;
    await image.decode();
    const scale = 2;
    const canvas = document.createElement('canvas');
    canvas.width = Math.round((width + pad * 2) * scale);
    canvas.height = Math.round((height + pad * 2) * scale);
    const context = canvas.getContext('2d')!;
    context.fillStyle = '#fff';
    context.fillRect(0, 0, canvas.width, canvas.height);
    context.drawImage(image, pad * scale, pad * scale, width * scale, height * scale);
    return new Promise((resolve, reject) =>
      canvas.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('PNG export failed'))), 'image/png'),
    );
  }

  async function diagramPng(figure: HTMLElement): Promise<Blob> {
    const svg = figure.querySelector('svg')!;
    const { width, height } = svg.viewBox.baseVal;
    const copy = standalone(svg);
    copy.setAttribute('width', String(width));
    copy.setAttribute('height', String(height));
    const url = URL.createObjectURL(
      new Blob([new XMLSerializer().serializeToString(copy)], { type: 'image/svg+xml' }),
    );
    try {
      return await draw(url, width, height, 16);
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  async function coverPng(figure: HTMLElement): Promise<Blob> {
    const img = figure.querySelector('img')!;
    return draw(img.currentSrc || img.src, img.naturalWidth / 2, img.naturalHeight / 2, 0);
  }

  async function handleImage(button: HTMLButtonElement, png: () => Promise<Blob>, name: string) {
    if (button.dataset.xImage === 'download') {
      const url = URL.createObjectURL(await png());
      const link = Object.assign(document.createElement('a'), { href: url, download: `${name}.png` });
      link.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      say(`Downloaded ${name}.png.`);
      return;
    }
    try {
      await navigator.clipboard.write([new ClipboardItem({ 'image/png': png() })]);
      say(`Copied ${name} as an image.`);
    } catch {
      say('This browser would not copy the image. Use Download PNG instead.');
    }
  }

  // The draft's Markdown, with each diagram fence swapped for its placeholder.
  const source = JSON.parse(document.querySelector('[data-x-markdown]')!.textContent || '""') as string;
  let image = 0;
  const markdown = source.replace(/^```mermaid\n[\s\S]*?^```$/gm, () => `[Insert image ${++image}]`);
  // Markdown tables in source order, matching the rendered <table> elements.
  const tableSources = [...markdown.matchAll(/^(?:\|.*\|[ \t]*\n?)+/gm)].map((match) => match[0].trimEnd());

  const slug = location.pathname.split('/').filter(Boolean).at(-1) ?? 'x';

  figures.forEach((figure, index) => {
    const n = index + 1;
    figure.classList.remove('pele-diagram-expandable');
    const actions = document.createElement('div');
    actions.className = 'x-actions not-prose';
    actions.dataset.xActions = '';
    actions.innerHTML = `<span>Image ${n}</span>
      <button type="button" class="x-button" data-x-image="copy">Copy image</button>
      <button type="button" class="x-button" data-x-image="download">Download PNG</button>`;
    actions.querySelectorAll<HTMLButtonElement>('button').forEach((button) =>
      button.addEventListener('click', () => handleImage(button, () => diagramPng(figure), `${slug}-${n}`)),
    );
    figure.after(actions);
  });

  body.querySelectorAll('table').forEach((table, index) => {
    const n = index + 1;
    const actions = document.createElement('div');
    actions.className = 'x-actions not-prose';
    actions.dataset.xActions = '';
    actions.innerHTML = `<span>Table ${n}</span>
      <button type="button" class="x-button">Copy as Markdown</button>`;
    actions.querySelector('button')!.addEventListener('click', async () => {
      const table = tableSources[index];
      say(table && (await copyText(table)) ? `Copied table ${n} as Markdown.` : `Could not copy table ${n}.`);
    });
    table.after(actions);
  });

  const cover = document.querySelector<HTMLElement>('[data-x-cover]');
  cover?.querySelectorAll<HTMLButtonElement>('button').forEach((button) =>
    button.addEventListener('click', () => handleImage(button, () => coverPng(cover), `${slug}-cover`)),
  );

  // The body as X should receive it: diagrams become placeholders, buttons are dropped.
  function exportBody(): HTMLElement {
    const copy = body.cloneNode(true) as HTMLElement;
    copy.querySelectorAll('[data-x-actions]').forEach((element) => element.remove());
    copy.querySelectorAll('.pele-diagram').forEach((figure, index) => {
      const marker = document.createElement('p');
      marker.textContent = `[Insert image ${index + 1}]`;
      figure.replaceWith(marker);
    });
    copy.querySelectorAll('table').forEach((table, index) => {
      const marker = document.createElement('p');
      marker.textContent = `[Insert table ${index + 1}]`;
      table.replaceWith(marker);
    });
    return copy;
  }

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  async function copyRich(html: string, text: string) {
    try {
      await navigator.clipboard.write([
        new ClipboardItem({
          'text/html': new Blob([html], { type: 'text/html' }),
          'text/plain': new Blob([text], { type: 'text/plain' }),
        }),
      ]);
      return true;
    } catch {
      return copyText(text);
    }
  }

  document.querySelector('[data-x-copy="title"]')?.addEventListener('click', async () => {
    const title = document.querySelector('[data-x-title]')!.textContent!.trim();
    say((await copyText(title)) ? 'Title copied.' : 'Could not copy the title.');
  });

  document.querySelector('[data-x-copy="body"]')?.addEventListener('click', async () => {
    const copy = exportBody();
    // innerText needs the element in the document to see paragraph breaks.
    copy.style.position = 'absolute';
    copy.style.left = '-9999px';
    document.body.append(copy);
    const text = copy.innerText;
    copy.remove();
    say((await copyRich(copy.innerHTML, text)) ? 'Body copied with formatting.' : 'Could not copy the body.');
  });

  document.querySelector('[data-x-copy="markdown"]')?.addEventListener('click', async () => {
    say((await copyText(markdown)) ? 'Body copied as Markdown.' : 'Could not copy the Markdown.');
  });
</script>
