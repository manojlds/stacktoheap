---
import { editablePosts } from './posts';

const posts = await editablePosts();
const day = (date: Date) => date.toISOString().slice(0, 10);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit posts</title>
  </head>
  <body>
    <header>
      <h1>Edit posts</h1>
      <a href="/">Site</a>
    </header>
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/_edit/${post.id}`}>
            <span class="title">{post.title}</span>
            <span class="meta">
              {day(post.date)}
              {post.draft && <span class="draft">draft</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: #f7f7f5;
    color: #1d2330;
  }
  header {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: #fff;
    border-bottom: 1px solid #e3e3df;
  }
  h1 { margin: 0; font-size: 1.1rem; }
  header a { color: #3a6ea5; }
  ul {
    list-style: none;
    margin: 0 auto;
    padding: 0.5rem;
    max-width: 48rem;
  }
  li a {
    display: block;
    padding: 0.8rem 0.75rem;
    border-bottom: 1px solid #e8e8e4;
    color: inherit;
    text-decoration: none;
  }
  li a:active, li a:hover { background: #eef2f7; }
  .title { display: block; font-weight: 600; }
  .meta { display: flex; gap: 0.5rem; margin-top: 0.2rem; font-size: 0.8rem; color: #6b7280; }
  .draft {
    padding: 0 0.4rem;
    border-radius: 999px;
    background: #fdf0d5;
    color: #8a5a00;
  }
</style>
