---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  excerpt?: string;
  date: Date;
  reading_time?: string;
  categories?: string[];
  tags?: string[];
  hero_image?: string;
}

const { title, excerpt, date, reading_time, categories = [], tags = [], hero_image } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<BaseLayout
  title={title}
  description={excerpt}
  image={hero_image}
  article={true}
  publishedTime={date}
  tags={tags}
  categories={categories}
>
  <article class="container py-8 md:py-12 lg:py-16">
    <div class="mx-auto max-w-3xl">
      <div class="space-y-4">
        <div class="flex flex-wrap gap-2">
          {categories.map((category) => (
            <a
              href={`/categories/${category}`}
              class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80"
            >
              {category}
            </a>
          ))}
        </div>
        <h1 class="scroll-m-20 text-3xl font-extrabold tracking-tight md:text-4xl">
          {title}
        </h1>
        {excerpt && (
          <p class="text-xl text-muted-foreground">
            {excerpt}
          </p>
        )}
        <div class="flex items-center gap-4 text-sm text-muted-foreground">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {reading_time && (
            <>
              <span>•</span>
              <span>{reading_time}</span>
            </>
          )}
        </div>
      </div>
      {hero_image && (
        <div class="blog-image my-8">
          <img
            src={hero_image}
            alt={title}
            class="w-full rounded-lg border border-border"
            loading="eager"
          />
        </div>
      )}
      <hr class="my-8" />
      <div class="prose prose-lg dark:prose-invert max-w-none prose-img:max-h-[400px] prose-img:w-auto prose-img:mx-auto prose-img:cursor-zoom-in prose-img:rounded-lg prose-img:border prose-img:border-border">
        <slot />
      </div>

      <!-- Shared image and diagram viewer -->
      <dialog id="media-lightbox" aria-labelledby="media-lightbox-title">
        <div id="media-lightbox-shell">
          <div id="media-lightbox-toolbar">
            <div>
              <p id="media-lightbox-title">Expanded media</p>
              <p id="media-lightbox-help">Drag to pan · Scroll or pinch to zoom</p>
            </div>
            <div id="media-lightbox-actions">
              <button type="button" data-media-action="zoom-out" aria-label="Zoom out">−</button>
              <button type="button" data-media-action="reset" aria-label="Reset zoom">100%</button>
              <button type="button" data-media-action="zoom-in" aria-label="Zoom in">+</button>
              <button type="button" data-media-action="close" aria-label="Close expanded view">×</button>
            </div>
          </div>
          <div id="media-lightbox-viewport">
            <img id="media-lightbox-content" src="" alt="" draggable="false" />
          </div>
          <p id="media-lightbox-caption"></p>
        </div>
      </dialog>
      {tags.length > 0 && (
        <div class="mt-8 pt-8 border-t">
          <div class="flex flex-wrap gap-2">
            <span class="text-sm font-medium">Tags:</span>
            {tags.map((tag) => (
              <a
                href={`/tags/${tag}`}
                class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 text-foreground hover:bg-accent hover:text-accent-foreground"
              >
                {tag}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>

  <script>
    const dialog = document.getElementById('media-lightbox') as HTMLDialogElement;
    const viewport = document.getElementById('media-lightbox-viewport') as HTMLDivElement;
    const media = document.getElementById('media-lightbox-content') as HTMLImageElement;
    const title = document.getElementById('media-lightbox-title') as HTMLParagraphElement;
    const caption = document.getElementById('media-lightbox-caption') as HTMLParagraphElement;
    const resetButton = dialog.querySelector('[data-media-action="reset"]') as HTMLButtonElement;

    let scale = 1;
    let fitScale = 1;
    let x = 0;
    let y = 0;
    let objectUrl = '';
    let opener: HTMLElement | null = null;
    const pointers = new Map<number, { x: number; y: number }>();
    let dragOrigin: { pointerX: number; pointerY: number; x: number; y: number } | null = null;
    let pinchOrigin: { distance: number; scale: number } | null = null;

    const renderTransform = () => {
      media.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${scale})`;
      resetButton.textContent = `${Math.round((scale / fitScale) * 100)}%`;
    };

    const resetView = () => {
      const width = media.naturalWidth || 1;
      const height = media.naturalHeight || 1;
      fitScale = Math.min(
        (viewport.clientWidth - 24) / width,
        (viewport.clientHeight - 24) / height,
        1
      );
      scale = fitScale;
      x = 0;
      y = 0;
      renderTransform();
    };

    const zoomAt = (nextScale: number, clientX?: number, clientY?: number) => {
      const maximum = Math.max(fitScale * 8, 4);
      const clamped = Math.min(maximum, Math.max(fitScale, nextScale));
      const rect = viewport.getBoundingClientRect();
      const focusX = (clientX ?? rect.left + rect.width / 2) - rect.left - rect.width / 2;
      const focusY = (clientY ?? rect.top + rect.height / 2) - rect.top - rect.height / 2;
      const ratio = clamped / scale;
      x = focusX - (focusX - x) * ratio;
      y = focusY - (focusY - y) * ratio;
      scale = clamped;
      renderTransform();
    };

    const openMedia = (
      src: string,
      alt: string,
      mediaTitle: string,
      mediaCaption = '',
      kind: 'image' | 'diagram' = 'image'
    ) => {
      media.onload = resetView;
      media.src = src;
      media.alt = alt;
      title.textContent = mediaTitle;
      caption.textContent = mediaCaption;
      caption.hidden = !mediaCaption;
      dialog.classList.toggle('media-lightbox-diagram', kind === 'diagram');
      document.body.classList.add('media-lightbox-open');
      dialog.showModal();
    };

    document.querySelectorAll('.prose img, .blog-image img').forEach((image) => {
      const imageElement = image as HTMLImageElement;
      imageElement.tabIndex = 0;
      imageElement.setAttribute('role', 'button');
      imageElement.setAttribute('aria-label', `Open larger view${imageElement.alt ? `: ${imageElement.alt}` : ''}`);
      const open = () => {
        opener = imageElement;
        const figure = imageElement.closest('figure');
        const imageCaption = figure?.querySelector('figcaption')?.textContent?.trim() ?? '';
        openMedia(imageElement.currentSrc || imageElement.src, imageElement.alt, 'Expanded image', imageCaption);
      };
      imageElement.addEventListener('click', open);
      imageElement.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          open();
        }
      });
    });

    document.querySelectorAll('.prose .mermaid').forEach((diagram) => {
      const diagramElement = diagram as HTMLElement;
      diagramElement.classList.add('mermaid-expandable');
      diagramElement.tabIndex = 0;
      diagramElement.setAttribute('role', 'button');
      diagramElement.setAttribute('aria-label', 'Open interactive diagram viewer');
      diagramElement.title = 'Open larger diagram';
      const open = () => {
        const svg = diagramElement.querySelector('svg');
        if (!svg) return;
        opener = diagramElement;
        const expandedSvg = svg.cloneNode(true) as SVGSVGElement;
        const viewBox = svg.viewBox.baseVal;
        if (viewBox.width && viewBox.height) {
          expandedSvg.setAttribute('width', String(viewBox.width));
          expandedSvg.setAttribute('height', String(viewBox.height));
        }
        const serialized = new XMLSerializer().serializeToString(expandedSvg);
        objectUrl = URL.createObjectURL(new Blob([serialized], { type: 'image/svg+xml' }));
        openMedia(objectUrl, 'Expanded Mermaid diagram', 'Expanded diagram', '', 'diagram');
      };
      diagramElement.addEventListener('click', open);
      diagramElement.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          open();
        }
      });
    });

    dialog.querySelector('[data-media-action="close"]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-media-action="zoom-in"]')?.addEventListener('click', () => zoomAt(scale * 1.25));
    dialog.querySelector('[data-media-action="zoom-out"]')?.addEventListener('click', () => zoomAt(scale / 1.25));
    resetButton.addEventListener('click', resetView);

    viewport.addEventListener('wheel', (event) => {
      event.preventDefault();
      zoomAt(scale * Math.exp(-event.deltaY * 0.0015), event.clientX, event.clientY);
    }, { passive: false });

    viewport.addEventListener('pointerdown', (event) => {
      viewport.setPointerCapture(event.pointerId);
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (pointers.size === 1) {
        dragOrigin = { pointerX: event.clientX, pointerY: event.clientY, x, y };
      } else if (pointers.size === 2) {
        const [first, second] = [...pointers.values()];
        pinchOrigin = { distance: Math.hypot(second.x - first.x, second.y - first.y), scale };
        dragOrigin = null;
      }
    });

    viewport.addEventListener('pointermove', (event) => {
      if (!pointers.has(event.pointerId)) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (pointers.size === 2 && pinchOrigin) {
        const [first, second] = [...pointers.values()];
        const distance = Math.hypot(second.x - first.x, second.y - first.y);
        zoomAt(
          pinchOrigin.scale * (distance / pinchOrigin.distance),
          (first.x + second.x) / 2,
          (first.y + second.y) / 2
        );
      } else if (pointers.size === 1 && dragOrigin) {
        x = dragOrigin.x + event.clientX - dragOrigin.pointerX;
        y = dragOrigin.y + event.clientY - dragOrigin.pointerY;
        renderTransform();
      }
    });

    const releasePointer = (event: PointerEvent) => {
      pointers.delete(event.pointerId);
      pinchOrigin = null;
      dragOrigin = null;
      if (pointers.size === 1) {
        const remaining = [...pointers.values()][0];
        dragOrigin = { pointerX: remaining.x, pointerY: remaining.y, x, y };
      }
    };
    viewport.addEventListener('pointerup', releasePointer);
    viewport.addEventListener('pointercancel', releasePointer);

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === '+' || event.key === '=') zoomAt(scale * 1.25);
      if (event.key === '-') zoomAt(scale / 1.25);
      if (event.key === '0') resetView();
    });
    dialog.addEventListener('close', () => {
      document.body.classList.remove('media-lightbox-open');
      media.removeAttribute('src');
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = '';
      dialog.classList.remove('media-lightbox-diagram');
      pointers.clear();
      opener?.focus();
    });
    window.addEventListener('resize', () => {
      if (dialog.open) resetView();
    });
  </script>
</BaseLayout>
